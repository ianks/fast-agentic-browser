#!/usr/bin/env python3
"""A fake password manager for fab's secrets end-to-end check (e2e.sh): fixed
items for the fixture pages, spoken over the fab-secret helper protocol."""
import os
import sys

origin = os.environ.get("FAB_FIXTURE_ORIGIN", "http://127.0.0.1:8799")
ITEMS = {
    "acme": {"title": "Acme", "kind": "login", "url": origin, "username": "ada@acme.test",
             "fields": {"username": "ada@acme.test", "current-password": "correct horse battery", "one-time-code": "123456"}},
    "visa": {"title": "Personal Visa", "kind": "card",
             "fields": {"cc-number": "4242424242424242", "cc-exp": "03/2029", "cc-csc": "737", "cc-name": "Ada Lovelace"}},
    "me": {"title": "Ada", "kind": "identity",
           "fields": {"name": "Ada Lovelace", "given-name": "Ada", "family-name": "Lovelace", "address-line1": "12 Analytical Row",
                      "address-level2": "London", "postal-code": "N1 9GU", "country-name": "United Kingdom", "email": "ada@acme.test"}},
    "stripe": {"title": "Stripe", "kind": "other",
               "fields": {"test secret key": "sk_test_51FabFixtureKey0000", "live secret key": "sk_live_51FabFixtureKey9999"}},
}

action = sys.argv[1] if len(sys.argv) > 1 else ""
given = dict(line.split("=", 1) for line in sys.stdin.read().splitlines() if "=" in line)
if action == "list":
    for key, it in ITEMS.items():
        print(f"id={key}\ntitle={it['title']}\nkind={it['kind']}")
        if "url" in it:
            print(f"url={it['url']}")
        if "username" in it:
            print(f"username={it['username']}")
        for f in it["fields"]:
            print(f"field={f}")
        print()
elif action == "get":
    it = ITEMS.get(given.get("id", ""))
    if not it:
        sys.exit(1)
    value = it["fields"].get(given.get("field", "")) or it["fields"].get(given.get("label", ""))
    if value is None:
        sys.exit(1)
    print(f"value={value}")
elif action == "store":
    with open(os.environ.get("FAB_FIXTURE_STORE", os.devnull), "a") as log:
        log.write(f"stored {given.get('url')} {given.get('username')} {len(given.get('password', ''))} chars\n")
    print(f"title={given.get('title', '')}")
else:
    print(f"unknown action {action}", file=sys.stderr)
    sys.exit(2)
